<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BaralhoTruco" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <!-- Error -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <!-- Background e Surface -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <!-- Outline -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
    </style>

    <style name="Theme.BaralhoTruco" parent="Base.Theme.BaralhoTruco" />

    <!-- ActionBar verde com texto e ícones brancos -->
    <style name="Widget.BaralhoTruco.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/md_primary</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="ThemeOverlay.BaralhoTruco.ActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!-- Tipografia -->
    <style name="TextAppearance.BaralhoTruco.Score" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <style name="TextAppearance.BaralhoTruco.PlayerName" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.BaralhoTruco.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!-- Botões de pontuação (+1, +3...) -->
    <style name="Widget.BaralhoTruco.ScoreButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- Botão de ação (Hist. de Jogadas, Inf. Nomes) -->
    <style name="Widget.BaralhoTruco.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/md_surface_container</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Botão de reset (Zerar Histórico) -->
    <style name="Widget.BaralhoTruco.ResetButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/md_error_container</item>
        <item name="android:textColor">@color/md_on_error_container</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
